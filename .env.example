# core-api
DB_URL=jdbc:postgresql://localhost:5433/travelpal
DB_USER=travelpal
DB_PASSWORD=travelpal
# EC P-256 PEM keys for access tokens (openssl ecparam -name prime256v1 -genkey | openssl pkcs8 -topk8 -nocrypt)
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
COOKIE_SECURE=true
PLACES_URL=https://photon.komoot.io

AI_SERVICE_URL=http://localhost:8090
# Private EC P-256 JWK (JSON) signing core-api -> ai-service tokens; set in every deployed core-api task
INTERNAL_JWT_PRIVATE_JWK=
# Optimize job queues. Locally LocalStack (docker compose); leave empty in AWS to use the real endpoint.
SQS_ENDPOINT=http://localhost:4566
AWS_REGION=us-east-1

# ai-service
ANTHROPIC_API_KEY=
# Optional: defaults to claude-opus-5-5
CLAUDE_MODEL=
VOYAGE_API_KEY=
# ai-service verifies core-api's service tokens with core-api's public JWKS (or a pinned PEM key)
INTERNAL_JWKS_URL=http://localhost:8081/.well-known/internal-jwks.json
INTERNAL_JWT_PUBLIC_KEY=
