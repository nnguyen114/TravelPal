# core-api (Spring reads real environment variables; this file documents them and feeds ai-service locally)
# Either a JDBC URL plus user/password, or a host-style DATABASE_URL (postgres://user:pass@host:port/db, e.g. Render).
DB_URL=jdbc:postgresql://localhost:5433/travelpal
DB_USER=travelpal
DB_PASSWORD=travelpal
# EC P-256 PEM keys for access tokens (openssl ecparam -name prime256v1 -genkey | openssl pkcs8 -topk8 -nocrypt)
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
COOKIE_SECURE=true
# Shared counters, ended sessions and live updates (docker compose runs Redis locally)
REDIS_URL=redis://localhost:6379
# true = make throwaway signing keys when the key settings are empty. Must be false in AWS.
DEV_KEYS=true
# Place search (Photon), used by both services. Public server is fair-use only: self-host before real traffic.
PLACES_URL=https://photon.komoot.io
# Real client IP header set by a trusted edge (CloudFront-Viewer-Address in AWS); empty = connection address.
CLIENT_IP_HEADER=

AI_SERVICE_URL=http://localhost:8090
# Private EC P-256 JWK (JSON) signing core-api -> ai-service tokens; set in every deployed core-api task
INTERNAL_JWT_PRIVATE_JWK=
# Optimize jobs: sqs (AWS; LocalStack locally) or http (no queue service, e.g. Render: jobs go straight to ai-service).
OPTIMIZE_QUEUE=sqs
# Locally LocalStack (docker compose); leave empty in AWS to use the real endpoint.
SQS_ENDPOINT=http://localhost:4566
AWS_REGION=us-east-1

# ai-service
# false where there is no queue to poll (OPTIMIZE_QUEUE=http)
WORKER_ENABLED=true
ANTHROPIC_API_KEY=
# Optional: defaults to claude-opus-5-5
CLAUDE_MODEL=
VOYAGE_API_KEY=
# ai-service verifies core-api's service tokens with core-api's public JWKS (or a pinned PEM key)
INTERNAL_JWKS_URL=http://localhost:8081/.well-known/internal-jwks.json
INTERNAL_JWT_PUBLIC_KEY=
